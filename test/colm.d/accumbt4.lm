#
# Backtracking over reduction actions that send to an accum parser. The undo
# of each send must take out what that send appended: its own text, stream
# or tree, wherever the buffer holding it has got to. Input ending in ";" is
# parsed as A1 first, then backs up to A2, undoing every send, and must give
# the same tree as input ending in "!".
#

lex
	ignore /[ \t\n\r\v]+/
	token id /[a-zA-Z_][a-zA-Z0-9_]*/
end

def nested [id*]

context accum_bt

NestedParser: accum<nested>

lex
	ignore /[ \t]+/
	token word /[a-z]+/
	literal `% `^ `@ `* `! `;
	token NL /'\n'/
end

def A1 []
def A2 []

def item
	# A stream, then text. Undoing the text used to leave its emptied accum
	# at the tail, and undoing the stream popped that instead.
	[`% word]
	{
		send NestedParser [open( 'accumbt4.in', 'r' )]
		send NestedParser [' ']
		send NestedParser [$r2]
		send NestedParser [' ']
	}

	# A tree between text. Undoing it used to leave the tree in.
|	[`^ word]
	{
		I: id = make_token( typeid<id>, $r2 )
		send NestedParser [' t ']
		send_tree NestedParser [I]
		send NestedParser [' ']
	}

	# An empty stream. Scanning the text after it moves it to the stash.
|	[`@ word]
	{
		send NestedParser [open( '/dev/null', 'r' )]
		send NestedParser [$r2]
		send NestedParser [' ']
	}

	# Empty text between trees gets its own accum, which consuming the second
	# tree moves to the stash. A literal '' would send nothing.
|	[`* word]
	{
		I: id = make_token( typeid<id>, $r2 )
		J: id = make_token( typeid<id>, 'x' )
		E: str = ''
		send_tree NestedParser [I]
		send NestedParser [E]
		send_tree NestedParser [J]
		send NestedParser [' ']
	}

# The parse ends here: finish the accum parser.
def two
	[A1 item* `! NL]
	{ send NestedParser [] eos }
|	[A2 item* `; NL]
	{ send NestedParser [] eos }

end # accum_bt

AccumBt: accum_bt = new accum_bt()
AccumBt->NestedParser = new parser<nested>()

parse Two: accum_bt::two( AccumBt )[ stdin ]

Nested: nested = AccumBt->NestedParser->tree
print( '[', Nested, ']\n' )

##### IN #####
%ab %cd !
##### EXP #####
[zz  ab zz  cd ]
##### IN #####
%ab %cd ;
##### EXP #####
[zz  ab zz  cd ]
##### IN #####
^ab ^cd ;
##### EXP #####
[ t ab  t cd ]
##### IN #####
@ab @cd ;
##### EXP #####
[ab cd ]
##### IN #####
*ab *cd ;
##### EXP #####
[abx cdx ]
##### IN #####
%ab ^cd @ef *gh !
##### EXP #####
[zz  ab  t cd ef ghx ]
##### IN #####
%ab ^cd @ef *gh ;
##### EXP #####
[zz  ab  t cd ef ghx ]
##### IN #####
*ab @cd ^ef %gh ;
##### EXP #####
[abx cd  t ef zz  gh ]
