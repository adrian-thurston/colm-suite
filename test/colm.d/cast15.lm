# A ref to a type that isn't a tree is an error at its type. The cast check
# used to leave a ref to an int, which has no lang el, as it was, and colm
# segfaulted on it.
lex
	token id /[a-z]+/
	ignore /[ \n]+/
end
void show( R: ref<int> )
{
	T: id = cast<id> R
	print( T, "\n" )
}
print( "compiled\n" )
##### COMP_ERR #####
8:15: ref takes a tree type
