# The cast check leaves a ref to a type that isn't a tree, which has no lang
# el, as it was: the cast compiles. colm segfaulted on it. show is never
# called, since a cast of an int's ref crashes the program.
lex
	token id /[a-z]+/
	ignore /[ \n]+/
end
void show( R: ref<int> )
{
	T: id = cast<id> R
	print( T, "\n" )
}
print( "compiled\n" )
##### EXP #####
compiled
