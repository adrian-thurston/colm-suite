# The token an ignore collector sends has the location of the text the
# scanner stopped at. A parse error at it reports that location.

lex
	ignore /space+/
	literal `( -ni
	literal ni- `)
	literal `;
	token id /[a-zA-Z_0-9]+/
end

lex
	ignore /space+/
	token inner_t /[a-zA-Z_0-9]+/
	token empty -
end

def inner
	[inner_t*]
|	[empty]

def item
	[id]
|	[`( inner `)]

def start
	[item* `;]

parse Start: start[ stdin ]

if ( ! Start )
	print( error, '\n' )
##### IN #####
(;
##### EXP #####
<stdin>:1:2: parse error
