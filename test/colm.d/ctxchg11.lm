# Another parse's action, through a reference to the object.
# The global can't hold a context object: colm refuses it first.
include 'ctxrule.lmi'

global G: ctx = new ctx()
G->L = new list<str>()

context other
	lex
		token v /[a-z]+/
		ignore /[ \n]+/
	end

	def start
		[v*]
		{
			G->L->push_tail( "y" )
		}
end

O: other = new other()
parse T: other::start( O )[ "a" ]
##### COMP_ERR #####
5:11: G can't hold a ctx: a context object is held only by a local variable, a parameter, a return or a field of a context
