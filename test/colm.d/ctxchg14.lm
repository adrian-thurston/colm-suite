# A function call ends the setup of a global's object.
# The global can't hold a context object: colm refuses it first.
include 'ctxrule.lmi'

global C: ctx = new ctx()
C->L = new list<str>()
global P: parser<ctx::start>

void start()
{
	P = new parser<ctx::start>( C )
	send P "a "
}

start()
C->L->pop_tail()
##### COMP_ERR #####
5:11: C can't hold a ctx: a context object is held only by a local variable, a parameter, a return or a field of a context
