# A send to a parser the object holds, between two sends (#368's form).
include 'ctxrule.lmi'

C: ctx = new ctx()
C->Inner = new parser<ctx::inner>( C )
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "a "
send C->Inner "x "
##### COMP_ERR #####
8:6: cannot change C, a context object, outside its setup
