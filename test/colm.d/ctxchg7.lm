# A change in a loop's body, with a parse of the object after it: the parse
# is lent the object for its statement, and gives it back, so each pass
# finds it as the last left it.
include 'ctxrule.lmi'

C: ctx = new ctx()
I: int = 0
while ( I < 2 ) {
	C->N = I
	parse S: ctx::start( C )[ "a" ]
	I = I + 1
}
print( C->N, "\n" )
##### EXP #####
1
