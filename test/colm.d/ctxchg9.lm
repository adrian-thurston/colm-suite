# Giving the object to a new parser lends it until the parser's finish():
# a change after the statement doesn't compile.
include 'ctxrule.lmi'

C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
C->N = 1
##### COMP_ERR #####
7:1: cannot use C: it is lent to P (6:25) until P->finish()
