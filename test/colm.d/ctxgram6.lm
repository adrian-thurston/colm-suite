# Nor another context's tokens. Here c::word's action would pass this, the
# parse's e, to a parse of c::rest as its c.

context c
	N: int
	lex
		token word /[a-z]+/
		{
			W: str = input->pull( match_length )
			parse_stop R: c::rest( this input )[]
			input->push( make_token( typeid<word>, W ) )
		}
		ignore /space+/
	end
	lex
		token rw /[a-z]+/
		ignore /space+/
	end
	def rest
		[rw]
		{
			N = N + 1
		}
end
context e
	S: str
	def start [c::word*]
end
E: e = new e()
parse S: e::start( E )[ "a x b" ]
print( S, "\n" )
##### COMP_ERR #####
30:1: e::start can't be parsed: its grammar uses c::word, of context c, and e::start isn't in c
