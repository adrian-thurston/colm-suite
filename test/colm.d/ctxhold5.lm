# A parse given another object between two sends to a parser made with new:
# the parser is lent C until its finish(), and the parse is given D, which
# no parser is lent.
context ctx
	L: list<str>

	lex
		ignore /[ \t]+/
		literal `* `^ `; `-
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			L->push_tail( "x" )
		}

	def popper
		[`-]
		{
			L->pop_tail()
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]

	lex
		token go /'go'/
		{
			Q: parser<ctx::popper> = new parser<ctx::popper>( this )
			input->push( make_token( typeid<go>, input->pull( match_length ) ) )
		}
	end

	def drive
		[go]
end

C: ctx = new ctx()
C->L = new list<str>()
D: ctx = new ctx()
D->L = new list<str>()
D->L->push_tail( "y" )
print( "before\n" )
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
parse X: ctx::popper( D )[ "-" ]
send P "\n"
print( P->finish() )
print( "C ", C->L->length, ", D ", D->L->length, "\n" )
##### EXP #####
before
* ;
C 0, D 0
