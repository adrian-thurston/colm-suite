# What a context object can still be given to. Two parses one after the
# other, the second seeing what the first's actions left: a parse that ends
# outside any action lets its object go. A parse that a token action starts,
# given the action's context, while the action's parse holds it. A parser
# made with new, given the object once the parses of it have ended.
context ctx
	L: list<str>

	lex
		ignore /[ \t]+/
		literal `* `^ `; `-
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			L->push_tail( "x" )
		}

	def popper
		[`-]
		{
			L->pop_tail()
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]

	lex
		ignore /[ \t]+/
		token go /'go'/
		{
			parse I: ctx::start( this )[ "* ; ^\n" ]
			print( "inner ", I )
			input->push( make_token( typeid<go>, input->pull( match_length ) ) )
		}
	end

	def drive
		[go go]
end

C: ctx = new ctx()
C->L = new list<str>()

parse S: ctx::start( C )[ "* * ; ^\n" ]
print( "L ", C->L->length, ", S ", S )
parse T: ctx::popper( C )[ "-" ]
print( "L ", C->L->length, ", T ", T, "\n" )
parse D: ctx::drive( C )[ "go go" ]
print( "L ", C->L->length, ", D ", D, "\n" )

P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
send P "\n"
print( "L ", C->L->length, ", P ", P->finish() )
##### EXP #####
L 2, S * * ; ^
L 1, T -
inner * ; ^
inner * ; ^
L 3, D go go
L 3, P * ;
