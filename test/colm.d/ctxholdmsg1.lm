# The message giving a parser a context object that another parser holds
# stops the program with, from a new parser and from a parse. The host sends
# standard error to standard output, so the message is in the output, after
# what the program printed before it. The stop ends the host too: it never
# gets back from colm_run_program.
context ctx
	lex
		token id /[a-z]+/
		ignore /space+/
	end

	def start
		[id*]
end

A: str = argv->pop()
C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
print( "before\n" )

if ( A == "new" ) {
	Q: parser<ctx::start> = new parser<ctx::start>( C )
}
elsif ( A == "parse" ) {
	parse S: ctx::start( C )[ "a b" ]
}

print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
new
##### EXP #####
before
fatal: giving a parser a context that another parser holds
##### EXIT #####
1
##### ARGS #####
parse
##### EXP #####
before
fatal: giving a parser a context that another parser holds
##### EXIT #####
1
