# A loan whose object was lent again, given to a ref parameter.
include 'ctxloan.lmi'

void show( R: ref<ctx::holder> )
{
	print( R, "\n" )
}

C: ctx = new ctx()
C->R = new rec()
C->R->L = new list<int>()
parse H: ctx::holder( C )[ "h" ]
parse S: ctx::start( C )[ "* ;\n" ]
show( H )
