# A local unique on one side of an if, and a loan on D on the other: after
# the if it is neither unique nor a held loan, so it can't go back into D,
# as a held loan on D could.
include 'ctxloan.lmi'

global N: int = 0

C: ctx = new ctx()
C->R = new rec()
D: ctx = new ctx()
D->R = new rec()
U: rec = new rec()
if ( N == 0 )
	U = D->R
D->R = U
