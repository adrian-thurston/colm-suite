# A token action's parse given this makes a tree that is the parse's own,
# as what it reads by a context variable's name is: it goes into a context
# variable.
struct rec
	N: int
end

context ctx
	S: rec
	T: holder

	lex
		ignore /[ \t]+/
		literal `h
		token go /'go'/
		{
			parse H: ctx::holder( this )[ "h" ]
			T = H
			input->push( make_token( typeid<go>, input->pull( match_length ) ) )
		}
	end

	def holder
		HR: rec
		[`h]
		{
			lhs.HR = S
		}

	def drive
		[go]
end

C: ctx = new ctx()
C->S = new rec()
C->S->N = 7
parse D: ctx::drive( C )[ "go" ]
print( D, " ", C->T.HR->N, "\n" )
##### EXP #####
go 7
