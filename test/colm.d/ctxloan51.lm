# The same with the for-good parser finished too: a for-good parser's tree
# isn't read, finished or not.
include 'ctxloan.lmi'

global N: int = 1

C: ctx = new ctx()
C->R = new rec()
P: parser<ctx::holder>
if ( N == 0 ) {
	P = new parser<ctx::holder>( C )
	send P "h"
	P->finish()
}
else {
	P = new parser<ctx::holder>( new ctx() )
	send P "h"
	P->finish()
}
X: ctx::holder = P->tree
print( X, "\n" )
##### COMP_ERR #####
20:18: cannot read P->tree: the parser has its context object for good, and a ctx::holder can hold a list, map, parser, stream or struct
