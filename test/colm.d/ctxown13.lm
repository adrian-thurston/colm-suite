# A parser finished on one side of an if only can't be sent to after it, and
# keeps what it is lent.
include 'ctxrule.lmi'

A: str = argv->pop()
C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "a "
if ( A == "x" ) {
	T: ctx::start = P->finish()
}
send P "b"
##### COMP_ERR #####
12:6: cannot send to P: it was finished at 10:21
