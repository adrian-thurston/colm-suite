# What goes into a context object through a reference to it is new, nil or
# what the object holds, after its parse as before it.
include 'ctxrule.lmi'

global GL: list<str> = new list<str>()

C: ctx = new ctx()
parse S: ctx::start( C )[ "a" ]
C->L = GL
##### COMP_ERR #####
9:8: only a new object, nil or what C holds can go into C
