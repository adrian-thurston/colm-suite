# A function that an iterator calls yields while its parameter, one of the
# context's variables, is lent to a parser: the loop's body can use the
# variable.
include 'ctxpush.lmi'

context outer
	Sub: ctx

	lex
		token v /[a-z]+/
		ignore /[ \n]+/
	end

	int g( O: ctx )
	{
		P: parser<ctx::start> = new parser<ctx::start>( O )
		send P "* ;"
		Y: str = "y"
		yield Y
		send P "\n"
		print( P->finish(), "\n" )
		return 0
	}

	iter each()
	{
		g( Sub )
	}

	def start
		[v]
		{
			for S: str in each() {
				print( "popped ", Sub->L->pop_tail(), "\n" )
			}
		}
end

C: outer = new outer()
C->Sub = new ctx()
C->Sub->L = new list<str>()
parse X: outer::start( C )[ "a" ]
print( "after\n" )
##### COMP_ERR #####
19:3: cannot yield while O is lent (16:27): the loop's body could use it
