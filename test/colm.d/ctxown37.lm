# An iterator calls a function that yields, while the running context is lent
# to a parser: the yield runs the loop's body, which can use the context.
include 'ctxpush.lmi'

context outer
	Sub: ctx

	lex
		token v /[a-z]+/
		ignore /[ \n]+/
	end

	int h()
	{
		Y: str = "y"
		yield Y
		return 0
	}

	iter each()
	{
		P: parser<ctx::start> = new parser<ctx::start>( Sub )
		send P "* ;"
		h()
		send P "\n"
		print( P->finish(), "\n" )
	}

	def start
		[v]
		{
			for S: str in each() {
				print( "popped ", Sub->L->pop_tail(), "\n" )
			}
		}
end

C: outer = new outer()
C->Sub = new ctx()
C->Sub->L = new list<str>()
parse X: outer::start( C )[ "a" ]
print( "after\n" )
##### COMP_ERR #####
24:3: cannot call h while the context object is lent (22:27): h can yield to a loop's body, which could use it
