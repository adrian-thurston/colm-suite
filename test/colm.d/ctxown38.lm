# A function that an iterator calls lends its parameter, then calls a function
# that yields: the loop's body can use the object.
include 'ctxpush.lmi'

context outer
	Sub: ctx

	lex
		token v /[a-z]+/
		ignore /[ \n]+/
	end

	int h()
	{
		Y: str = "y"
		yield Y
		return 0
	}

	int g( O: ctx )
	{
		P: parser<ctx::start> = new parser<ctx::start>( O )
		send P "* ;"
		h()
		send P "\n"
		print( P->finish(), "\n" )
		return 0
	}

	iter each()
	{
		g( Sub )
	}

	def start
		[v]
		{
			for S: str in each() {
				print( "popped ", Sub->L->pop_tail(), "\n" )
			}
		}
end

C: outer = new outer()
C->Sub = new ctx()
C->Sub->L = new list<str>()
parse X: outer::start( C )[ "a" ]
print( "after\n" )
##### COMP_ERR #####
24:3: cannot call h while O is lent (22:27): h can yield to a loop's body, which could use it
