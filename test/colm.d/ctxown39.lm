# A call given a context object and a new parser of it: the parser takes the
# object, so the function would get it twice, as a parameter and in the
# parser, and could change it while the parser can back up.
include 'ctxpush.lmi'

int f( O: ctx, P: parser<ctx::start> )
{
	send P "* ;"
	print( "popped ", O->L->pop_tail(), "\n" )
	send P "\n"
	print( P->finish(), "\n" )
	return 0
}

C: ctx = new ctx()
C->L = new list<str>()
f( C, new parser<ctx::start>( C ) )
print( "after\n" )
##### COMP_ERR #####
17:4: cannot give f C: another argument takes it with the parser made at 17:7
