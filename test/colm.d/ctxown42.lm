# A function lends its parameter to a parse whose item calls a function that
# yields: the loop's body runs between two of the parse's sends, and can use
# the object.
include 'ctxpush.lmi'

context outer
	Sub: ctx

	lex
		token v /[a-z]+/
		ignore /[ \n]+/
	end

	str g()
	{
		Y: str = "y"
		yield Y
		return "\n"
	}

	int h( O: ctx )
	{
		parse X: ctx::start( O )[ "* ;" g() ]
		print( X, "\n" )
		return 0
	}

	iter each()
	{
		h( Sub )
	}

	def start
		[v]
		{
			for S: str in each() {
				print( "popped ", Sub->L->pop_tail(), "\n" )
			}
		}
end

C: outer = new outer()
S: ctx = new ctx()
S->L = new list<str>()
C->Sub = S
parse X: outer::start( C )[ "a" ]
print( "after\n" )
##### COMP_ERR #####
23:35: cannot call g while O is lent (23:3): g can yield to a loop's body, which could use it
