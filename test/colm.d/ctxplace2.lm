# An export is a global, and can't hold a context object either.
context ctx
	lex
		token id /[a-z]+/
		ignore /space+/
	end

	def start
		[id*]
end

export E: ctx
##### COMP_ERR #####
12:11: E can't hold a ctx: a context object is held only by a local variable, a parameter, a return or a field of a context
