# A field of a struct that isn't a context can't hold a context object.
context ctx
	lex
		token id /[a-z]+/
		ignore /space+/
	end

	def start
		[id*]
end

struct holder
	C: ctx
end
##### COMP_ERR #####
13:5: C can't hold a ctx: a context object is held only by a local variable, a parameter, a return or a field of a context
