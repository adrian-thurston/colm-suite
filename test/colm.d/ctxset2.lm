# A tree with a list in its attribute goes into a context object as a cons
# or a parse makes it, and is read in place after the parse.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

def box
	[holder]

context ctx
	H: holder
	B: box

	lex
		token w /[a-z]+/
		ignore /[ \n]+/
	end

	def item
		[w]
		{
			H.L->push_tail( $r1 )
		}

	def start
		[item*]
end

C: ctx = new ctx()
C->H = cons holder [ "h" ]
C->H.L = new list<str>()
C->B = parse box[ "h" ]
parse S: ctx::start( C )[ "a b" ]
print( "H.L ", C->H.L->length, ":" )
for V: str in C->H.L
	print( " ", V )
print( "\n" )
##### EXP #####
H.L 2: a b
