# A list the object holds, read into a variable after its parse: a loan,
# through which the program changes the object's list.
include 'ctxrule.lmi'

C: ctx = new ctx()
C->L = new list<str>()
parse S: ctx::start( C )[ "a" ]
L: list<str> = C->L
L->push_tail( "x" )
print( C->L->length, "\n" )
##### EXP #####
1
