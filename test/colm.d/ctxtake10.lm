# The parse's action makes the context's tree, whose attribute holds a list,
# and the program takes a copy of it out between two sends. The copy shares
# the list.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

context ctx
	T: holder

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			if ( !T ) {
				T = cons holder [ "h" ]
				T.L = new list<str>()
			}
			T.L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
X: holder = C->T
print( "length ", X.L->length, "\n" )
X.L->pop_tail()
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
42:16: cannot take T out of C, a context object
