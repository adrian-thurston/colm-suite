# What find gives from a context's map of trees whose attribute holds a list,
# read between two sends, is a copy that shares the list.
# Between the sends, C is lent to P, so the use of C is refused, as any use
# of it is.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

context ctx
	M: map<str, holder>

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			if ( !M->find( "k" ) ) {
				H: holder = cons holder [ "h" ]
				H.L = new list<str>()
				M->insert( "k", H )
			}
			T: holder = M->find( "k" )
			T.L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

C: ctx = new ctx()
C->M = new map<str, holder>()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
X: holder = C->M->find( "k" )
X.L->pop_tail()
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
46:13: cannot use C: it is lent to P (44:25) until P->finish()
