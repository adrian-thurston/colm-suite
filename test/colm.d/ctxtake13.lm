# A tree whose child, not its attribute, holds a list goes into the context
# at setup. The program keeps the tree, which shares the list.
lex
	ignore /[ ]+/
	literal `h `w
end

def holder
	L: list<str>
	[`h]

def wrap
	[`w holder]

context ctx
	W: wrap

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			W.holder.L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

parse W: wrap[ "w h" ]
W.holder.L = new list<str>()
C: ctx = new ctx()
C->W = W
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
W.holder.L->pop_tail()
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
41:8: only nil or what C holds can go into C: a wrap can hold a list, map, parser, stream or struct
