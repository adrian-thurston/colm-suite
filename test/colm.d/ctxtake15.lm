# Printing a context's tree whose attribute holds a list, after its parse,
# reads it in place. The list holds ints: #775's cycle check refuses a tree
# attribute that holds a list of trees.
lex
	literal `h
end

def holder
	L: list<int>
	[`h]

context ctx
	T: holder

	lex
		ignore /[ \t]+/
		literal `*
	end

	def item
		[`*]
		{
			T = cons holder [ "h" ]
			T.L = new list<int>()
		}

	def start
		[item*]
end

C: ctx = new ctx()
parse S: ctx::start( C )[ "*" ]
print( C->T, "\n" )
##### EXP #####
h
