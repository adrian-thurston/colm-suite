# Matching a context's tree whose attribute holds a list uses the tree as a
# value, which takes it out. ctxtake10's program, matching the tree between
# two sends.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

context ctx
	T: holder

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			if ( !T ) {
				T = cons holder [ "h" ]
				T.L = new list<str>()
			}
			T.L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
if ( match C->T [`h] )
	print( "h\n" )
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
42:15: cannot take T out of C, a context object
