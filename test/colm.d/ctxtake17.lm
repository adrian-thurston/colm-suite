# Taking the text of a context's tree whose attribute holds a list, with $,
# uses the tree as a value, which takes it out. ctxtake10's program, printing
# the text between two sends.
# Between the sends, C is lent to P, so the use of C is refused before the
# take is.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

context ctx
	T: holder

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			if ( !T ) {
				T = cons holder [ "h" ]
				T.L = new list<str>()
			}
			T.L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
print( $C->T, "\n" )
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
44:9: cannot use C: it is lent to P (42:25) until P->finish()
