# The tree of a parser that a context holds, of a type whose attribute holds
# a list, is taken out of the context like any such tree. ctxtake10's
# program, whose action also parses with the context's parser.
# Between the sends, C is lent to P, so the use of C is refused before the
# take is.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

context ctx
	T: holder
	HP: parser<holder>

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			if ( !T ) {
				T = cons holder [ "h" ]
				T.L = new list<str>()
			}
			T.L->push_tail( "x" )
			if ( !HP ) {
				HP = new parser<holder>()
				send HP "h" eos
			}
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
X: holder = C->HP->tree
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
49:13: cannot use C: it is lent to P (47:25) until P->finish()
