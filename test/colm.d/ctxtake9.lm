# A tree's list attribute, reached through a copy of the tree taken out of
# the context between two sends.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

context ctx
	T: holder

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	# A1 is tried first: the action runs, then the parser backs up to A2.
	def item
		[`*]
		{
			T.L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

parse H: holder[ "h" ]
H.L = new list<str>()
C: ctx = new ctx()
C->T = H
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
X: holder = C->T
print( "length ", X.L->length, "\n" )
X.L->pop_tail()
send P "\n"
print( P->finish(), "\n" )
##### COMP_ERR #####
38:8: only a new object, nil or what C holds can go into C as it is set up
