# A local used as a value on one side of an if isn't unique after it.
include 'ctxrule.lmi'

global GL: list<str>
L: list<str> = new list<str>()
I: int = 0
if ( I == 0 )
	GL = L
C: ctx = new ctx()
C->L = L
