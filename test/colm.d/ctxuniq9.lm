# A loop over a local's structs takes each one out: the local isn't unique.
include 'ctxrule.lmi'

global GR: rec
L: list<rec> = new list<rec>()
L->push_tail( new rec() )
for R: rec in L
	GR = R
C: ctx = new ctx()
C->Recs = L
