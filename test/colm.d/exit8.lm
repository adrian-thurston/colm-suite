lex
	ignore /[ \n]+/
	token id /'#'/
	token raw /[a-z]+/
	{
		T: str = match_text
		input->pull( match_length )
		input->push( make_token( typeid<id>, T ) )
		if T == 'stop'
			exit( 3 )
	}
end

def start
	[id*]

parse S: start["abc def stop ghi"]
print( S, '\n' )
##### EXP #####
##### EXIT #####
3
