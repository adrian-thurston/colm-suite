# A loop over a list of str with a loop variable of another tree type.
lex
	token id /[a-z]+/
	ignore /[ \n]+/
end
def pair [A: id B: id]
L: list<str> = new list<str>()
L->push_tail( "a" )
for P: pair in L
	print( P.B, "\n" )
##### COMP_ERR #####
9:5: loop variable P must have the list's value type or its element type
