# The loop variable types a loop over a list or a map takes.
alias strlist list<str>
LL: list<strlist> = new list<strlist>()
L: list<str> = new list<str>()
L->push_tail( "a" )
L->push_tail( "b" )
LL->push_tail( L )
for X: list<str> in LL
	print( "nested ", X->length, "\n" )
for X: strlist in LL
	print( "alias ", X->length, "\n" )
for S: str in L
	print( "value ", S, "\n" )
for S: str in rev_list_iter( L )
	print( "rev ", S, "\n" )
for A: any in L
	print( "any ", A, "\n" )
LA: list<any> = new list<any>()
LA->push_tail( "c" )
for S: str in LA
	print( "from any ", S, "\n" )
M: map<str, str> = new map<str, str>()
M->insert( "k", "v" )
for V: str in M
	print( "map value ", V, "\n" )
for K: str in map_keys( M )
	print( "map key ", K, "\n" )
for A: any in map_keys( M )
	print( "map key any ", A, "\n" )
for A: any in M
	print( "map any ", A, "\n" )
MI: map<int, int> = new map<int, int>()
MI->insert( 3, 4 )
for I: int in MI
	print( "map int ", I, "\n" )
for I: int in map_keys( MI )
	print( "map int key ", I, "\n" )
##### EXP #####
nested 2
alias 2
value a
value b
rev b
rev a
any a
any b
from any c
map value v
map key k
map key any k
map any v
map int 4
map int key 3
