# An assignment to a global in a token action.
global G: int = 0

lex
	token id /[a-z]+/
	{
		G = G + 1
		input->push( make_token( typeid<id>, input->pull( match_length ) ) )
	}
	literal `;
	ignore /[ \n]+/
end

def start
	[id* `;]

P: parser<start> = new parser<start>()
send P "a b ;" eos
##### COMP_ERR #####
7:3: cannot change G, a global, in an action of a restartable parser: keep the data in a context
