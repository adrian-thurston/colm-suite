# A global's list taken out in the action of a def defined outside any
# context, which the grammar of a context's def uses: a parse given a
# context runs it.
global GL: list<str> = new list<str>()

lex
	token id /[a-z]+/
	literal `;
	ignore /[ \n]+/
end

def item
	[id]
	{
		L: list<str> = GL
	}

context ctx
	def start
		[item* `;]
end

C: ctx = new ctx()
parse S: ctx::start( C )[ "a b ;" ]
print( S, "\n" )
##### COMP_ERR #####
15:18: cannot take GL, a global, out in an action of a parse given a context: keep the data in a context
