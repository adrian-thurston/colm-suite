# A restartable parser's actions read the attributes of a tree that a global
# holds in place, though the tree's L attribute holds a list: a str, the
# list's length and its values. The program pushes onto the list between
# sends, and P backs up from A1 to A2, so its actions run again and see it.
# L is weak: a list of trees in a tree's attribute makes a cycle, so a
# variable, Held, holds the list.
lex
	literal `h
end

def holder
	L: weak<list<str>>
	S: str
	[`h]

global G: holder

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

def item
	[`*]
	{
		print( "item: S ", G.S, ", L ", G.L->length, ":" )
		for V: str in G.L
			print( " ", V )
		print( "\n" )
	}

def start
	[A1 item* `; `^ NL]
|	[A2 item* `; NL]

parse H: holder[ "h" ]
Held: list<str> = new list<str>()
H.L = Held
H.S = "s"
G = H
G.L->push_tail( "a" )

P: parser<start> = new parser<start>()
send P "* * "
G.L->push_tail( "b" )
send P ";\n"
print( "P: ", P->finish() )
##### EXP #####
item: S s, L 1: a
item: S s, L 2: a b
item: S s, L 2: a b
item: S s, L 2: a b
P: * * ;
