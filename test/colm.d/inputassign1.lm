# Assigning to input in a token action is a compile error. input is the
# input being scanned, and nothing can set it.
context c
	lex
		token word /[a-z]+/
		{
			input = nil
		}
		ignore /space+/
	end
	def start [word*]
end
C: c = new c()
parse S: c::start( C )[ "a b" ]
print( S, "\n" )
##### COMP_ERR #####
7:4: cannot assign to "input"
