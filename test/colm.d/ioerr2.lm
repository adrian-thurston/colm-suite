#
# A read or write on stdin or stdout that the system refuses stops the program
# too. The host gives the program a directory as its standard input, or a full
# device as its standard output, and sends standard error to where standard
# output went, so the message is in the output. The argument picks which.
#

lex
	token word /[a-z]+/
	ignore /[ \n]+/
end

def start
	[word*]

A: str = argv->pop()

if ( A == "stdin_dir" ) {
	print( "before\n" )
	parse S: start[ stdin ]
	print( "parsed\n" )
}
elsif ( A == "stdout_full" ) {
	# Written out when the program ends.
	print( "lost\n" )
	send stderr "on stderr\n"
}
elsif ( A == "pop" ) {
	# Stopping for another mistake, the program prints that one.
	print( "lost\n" )
	L: list<int> = new list<int>()
	L->pop()
}
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	if ( strcmp( argv[1], "stdin_dir" ) == 0 )
		dup2( open( ".", O_RDONLY ), 0 );
	else
		dup2( open( "/dev/full", O_WRONLY ), 1 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	fprintf( stderr, "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
stdin_dir
##### EXP #####
before
fatal: could not read <stdin>: Is a directory
##### EXIT #####
1
##### ARGS #####
stdout_full
##### EXP #####
on stderr
fatal: could not write <stdout>: No space left on device
##### EXIT #####
1
##### ARGS #####
pop
##### EXP #####
fatal: pop from an empty list
##### EXIT #####
1
