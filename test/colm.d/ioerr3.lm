#
# An exit in an exported function that the host called ends the host's
# process at once, as exit19 shows. Before it does, every stream the program
# left open is closed, and a write that fails then stops the program instead,
# with the message and status 1, as in ioerr1. Here hello leaves a stream open
# on /dev/full. The host sends standard error to standard output, so the
# message is in the output. It never gets back from hello, so it never says
# its exit status.
#

global Out: stream

export str hello( S: str )
{
	Out = open( "/dev/full", "w" )
	send Out "text"
	print( "in hello\n" )
	exit( 0 )
	return S
}

print( "top\n" )
##### HOST #####

#include <iostream>
#include <string>
#include <unistd.h>
#include "working/ioerr3.if.h"

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *prg = colm_new_program( &colm_object );
	colm_run_program( prg, argc, argv );
	str S = hello( prg, "x" );
	std::string T = S.text();
	int status = colm_delete_program( prg );

	std::cout << "host after hello: " << T << std::endl;
	std::cout << "host: exit status " << status << std::endl;
	return status;
}
##### EXP #####
top
in hello
fatal: could not write /dev/full: No space left on device
##### EXIT #####
1
