# Popping a value off an empty or nil list ends the program
# with exit status 1. The output before the pop is kept.

L: list<int> = new list<int>()
S: list<str> = new list<str>()
N: list<int>
I: int
T: str

A: str = argv->pop()
print( "before\n" )

if ( A == "pop_head" )
	I = L->pop_head()
elsif ( A == "pop_tail" )
	T = S->pop_tail()
elsif ( A == "pop" )
	I = L->pop()
elsif ( A == "drain" ) {
	L->push_tail( 1 )
	I = L->pop_head()
	print( "got [I], length [L->length]\n" )
	I = L->pop_head()
}
elsif ( A == "nil" )
	I = N->pop()

print( "after\n" )
##### ARGS #####
pop_head
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
pop_tail
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
pop
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
drain
##### EXP #####
before
got 1, length 0
##### EXIT #####
1
##### ARGS #####
nil
##### EXP #####
before
##### EXIT #####
1
