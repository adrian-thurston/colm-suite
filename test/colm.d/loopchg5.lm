# A parse in the body of a for loop over a global's list or map runs an
# action that changes it: a push or a pop, or an insert, a set or a remove.
# The change stops the program. The parse isn't restartable, so its actions
# can change a global. The host sends standard error to standard output.
global Mode: str = argv->pop()
global L: list<str> = new list<str>()
global M: map<str, str> = new map<str, str>()

lex
	ignore /[ \t\n]+/
	literal `*
end

# Each item makes the change Mode names.
def item
	[`*]
	{
		if ( Mode == "push_tail" )
			L->push_tail( "x" )
		elsif ( Mode == "push_head" )
			L->push_head( "x" )
		elsif ( Mode == "pop_head" )
			L->pop_head()
		elsif ( Mode == "pop_tail" )
			L->pop_tail()
		elsif ( Mode == "insert" )
			M->insert( "d", "4" )
		elsif ( Mode == "set" )
			M->set( "d", "4" )
		elsif ( Mode == "remove" )
			M->remove( "a" )
	}

def start
	[item*]

L->push_tail( "x" )
M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )

if ( Mode == "insert" || Mode == "set" || Mode == "remove" ) {
	for V: str in M {
		print( "v [V]\n" )
		parse S: start[ "* " ]
	}
}
else {
	for V: str in L {
		print( "v [V]\n" )
		parse S: start[ "* " ]
	}
}
print( "after: L [L->length], M [M->length]\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
push_tail
##### EXP #####
v x
fatal: changing a list a loop is over
##### EXIT #####
1
##### ARGS #####
push_head
##### EXP #####
v x
fatal: changing a list a loop is over
##### EXIT #####
1
##### ARGS #####
pop_head
##### EXP #####
v x
fatal: changing a list a loop is over
##### EXIT #####
1
##### ARGS #####
pop_tail
##### EXP #####
v x
fatal: changing a list a loop is over
##### EXIT #####
1
##### ARGS #####
insert
##### EXP #####
v 1
fatal: changing a map a loop is over
##### EXIT #####
1
##### ARGS #####
set
##### EXP #####
v 1
fatal: changing a map a loop is over
##### EXIT #####
1
##### ARGS #####
remove
##### EXP #####
v 1
fatal: changing a map a loop is over
##### EXIT #####
1
