# A for loop over a context's list while a parser lent the object can back
# up over an action's change to it. The loop is a use of a lent object, so it
# doesn't compile. The parser tries A1 first: the action runs on "* ;", and
# the "\n" sent in the loop would make it back up to A2.
context ctx
	L: list<str>

	lex
		ignore /[ \t]+/
		literal `* `^ `;
		token NL /'\n'/
	end

	def A1 []
	def A2 []

	def item
		[`*]
		{
			L->push_tail( "x" )
		}

	def start
		[A1 item* `; `^ NL]
	|	[A2 `* `; NL]
end

C: ctx = new ctx()
C->L = new list<str>()
C->L->push_tail( "a" )
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "* ;"
for V: str in C->L {
	print( "v [V]\n" )
	send P "\n"
}
print( P->finish(), "\n" )
##### COMP_ERR #####
33:15: cannot use C: it is lent to P (31:25) until P->finish()
