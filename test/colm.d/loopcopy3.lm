# The variable of a loop over a global, given to a function that writes
# through its ref parameter.
lex
	token id /[a-z]+/
	ignore /[ \n]+/
end
def start [id*]
void setit( R: ref<id> ) { R = cons id "z" }
global G: start = parse start[ "a b" ]
for I: id in G
	setit( I )
print( "G=", G, "\n" )
##### COMP_ERR #####
10:5: the loop can write through I, so it must be over a local, or an attribute or child of one
