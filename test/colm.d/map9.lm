#
# A map's remove and detach_el give back the element they take out, as their
# map_el return type says. remove gives nil for a key that isn't in the map.
#

new M: map<str, str>()
M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )
M->insert( "d", "4" )

# The removed element still holds its key and value.
A: map_el<str, str> = M->remove( "a" )
if ( A )
	print "removed [A->key] [A->value]\n"
else
	print "a: nil\n"

# A key that is not in the map gives nil.
Z: map_el<str, str> = M->remove( "zz" )
if ( Z )
	print "removed [Z->key] [Z->value]\n"
else
	print "zz: nil\n"

# So the result can be tested directly.
if ( M->remove( "b" ) )
	print "removed b\n"
if ( M->remove( "b" ) )
	print "removed b again\n"

# detach_el gives back the element it was passed.
C: map_el<str, str> = M->find_el( "c" )
D: map_el<str, str> = M->detach_el( C )
print "detached [D->key] [D->value]\n"

# A removed element can go back in.
M->insert_el( A )

for E: map_el<str, str> in M
	print "[E->key] [E->value]\n"

##### EXP #####
removed a 1
zz: nil
removed b
detached c 3
a 1
d 4
