#
# A map's remove gives back the value it takes out. For a key that isn't in
# the map it gives nil, or 0 for an int value, as find does.
#

new M: map<str, str>()
M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )
M->insert( "d", "4" )

# The removed value.
A: str = M->remove( "a" )
print "removed a [A]\n"

# A key that is not in the map gives nil.
Z: str = M->remove( "zz" )
if ( Z )
	print "removed zz [Z]\n"
else
	print "zz: nil\n"

# So the result can be tested directly.
if ( M->remove( "b" ) )
	print "removed b\n"
if ( M->remove( "b" ) )
	print "removed b again\n"

# An int value, and 0 for a key that isn't there.
new I: map<int, int>()
I->insert( 1, 10 )
print "removed 1 [I->remove( 1 )], removed 1 again [I->remove( 1 )]\n"

# A removed value can go back in.
M->insert( "a", A )

for K: str in map_keys( M )
	print "[K] [M->find( K )]\n"

##### EXP #####
removed a 1
zz: nil
removed b
removed 1 10, removed 1 again 0
a 1
c 3
d 4
