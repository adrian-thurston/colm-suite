# Setting the key of a map element that no map holds doesn't stop: a new
# element, and one that detach_el or remove took out, takes a new key and goes
# in under it. Reading the key of an element a map holds, looping over it,
# changing a copy of it, or setting the element's value doesn't stop either,
# and leaves the map as it was.

lex
	token id /[a-z]+/
	ignore /[ \t\n]+/
end

def k [Id: id]

new M: map<str, str>()
M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )
M->insert( "d", "4" )
M->insert( "e", "5" )

G: map_el<str, str> = new map_el<str, str>()
G->key = "z"
G->value = "26"
M->insert_el( G )

D: map_el<str, str> = M->detach_el( M->find_el( "a" ) )
D->key = "y"
M->insert_el( D )

R: map_el<str, str> = M->remove( "b" )
R->key = "x"
M->insert_el( R )

for V: map_el<str, str> in M
	print( "[V->key] [V->value]\n" )
if ( M->find_el( "x" ) && M->find_el( "y" ) && M->find_el( "z" ) )
	print( "find_el x, y and z found them\n" )

new T: map<k, str>()
T->insert( parse k[ "a" ], "1" )
T->insert( parse k[ "b" ], "2" )
T->insert( parse k[ "c" ], "3" )

E: map_el<k, str> = T->find_el( parse k[ "a" ] )
print( "key [E->key], Id [E->key.Id]\n" )
for X: id in E->key
	print( "loop [X]\n" )
C: k = E->key
C.Id = parse id[ "q" ]
print( "copy [C], key [E->key]\n" )
E->value = "one"

for W: map_el<k, str> in T
	print( "[W->key] [W->value]\n" )
if ( T->find_el( parse k[ "a" ] ) )
	print( "find_el a found it\n" )
##### EXP #####
c 3
d 4
e 5
x 2
y 1
z 26
find_el x, y and z found them
key a, Id a
loop a
copy q, key a
a one
b 2
c 3
find_el a found it
