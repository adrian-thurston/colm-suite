# Setting the key of an element that a map holds in a reduction action, or
# changing something inside such a key, ends the program with exit status 1,
# as it does outside a parse. The output before it is kept.

lex
	ignore /[ \t]+/
	literal `+ `* `- `;
	token id /[a-z]+/
	token NL /'\n'/
end

def k [Id: id]

global M: map<str, str> = new map<str, str>()
global I: map<int, str> = new map<int, str>()
global T: map<k, str> = new map<k, str>()

def item
	[`+]
	{
		E: map_el<str, str> = M->find_el( "a" )
		print( "str key\n" )
		E->key = "z"
	}
|	[`*]
	{
		F: map_el<int, str> = I->find_el( 1 )
		print( "int key\n" )
		F->key = 9
	}
|	[`-]
	{
		G: map_el<k, str> = T->find_el( parse k[ "a" ] )
		print( "inside a key\n" )
		G->key.Id = parse id[ "z" ]
	}

def start
	[item* `; NL]

M->insert( "a", "1" )
M->insert( "b", "2" )
I->insert( 1, "1" )
I->insert( 2, "2" )
T->insert( parse k[ "a" ], "1" )
T->insert( parse k[ "b" ], "2" )

parse S: start[ stdin ]
print( S )
for V: map_el<str, str> in M
	print( "[V->key] [V->value]\n" )
##### IN #####
+ ;
##### EXP #####
str key
##### EXIT #####
1
##### IN #####
* ;
##### EXP #####
int key
##### EXIT #####
1
##### IN #####
- ;
##### EXP #####
inside a key
##### EXIT #####
1
