# The message each use of a nil map stops the program with. The host sends
# standard error to standard output, so the message is in the output, after
# what the program printed before it. The stop ends the host too: it never
# gets back from colm_run_program.

M: map<str, int>
I: int

A: str = argv->pop()
print( "before\n" )

if ( A == "insert" )
	M->insert( "a", 1 )
elsif ( A == "find" )
	I = M->find( "a" )
elsif ( A == "contains" )
	B: bool = M->contains( "a" )
elsif ( A == "remove" )
	M->remove( "a" )
elsif ( A == "set" )
	M->set( "a", 1 )
elsif ( A == "length" )
	I = M->length
elsif ( A == "map_keys" ) {
	for K: str in map_keys( M )
		print( "[K]\n" )
}

print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
insert
##### EXP #####
before
fatal: insert into a nil map
##### EXIT #####
1
##### ARGS #####
find
##### EXP #####
before
fatal: find in a nil map
##### EXIT #####
1
##### ARGS #####
remove
##### EXP #####
before
fatal: remove from a nil map
##### EXIT #####
1
##### ARGS #####
length
##### EXP #####
before
fatal: length of a nil map
##### EXIT #####
1
##### ARGS #####
contains
##### EXP #####
before
fatal: contains on a nil map
##### EXIT #####
1
##### ARGS #####
set
##### EXP #####
before
fatal: set in a nil map
##### EXIT #####
1
##### ARGS #####
map_keys
##### EXP #####
before
fatal: for loop over a nil map
##### EXIT #####
1
