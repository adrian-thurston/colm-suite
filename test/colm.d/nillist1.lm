# Using a nil list stops the program, with exit status 1: pushing a value at
# either end, its length, and the value at either end. The output before the
# stop is kept. In a reduction action, a push is the form that records reverse
# code. The run "new" gives the list a value first, and nothing stops.

lex
	token id /[a-z]+/
	ignore /[ \n]+/
end

struct holder
	L: list<int>
end

global N: list<int>
global A: str = argv->pop()

def start
	[id]
	{
		if ( A == "new" ) {
			N->push_head( 1 )
			N->push_tail( 2 )
			N->push_head( 3 )
			N->push_tail( 4 )
		}
		elsif ( A == "action_push_head" )
			N->push_head( 1 )
		elsif ( A == "action_push_tail" )
			N->push_tail( 1 )
	}

print( "before\n" )

if ( A == "push" )
	N->push( 1 )
elsif ( A == "push_head" )
	N->push_head( 1 )
elsif ( A == "push_tail" )
	N->push_tail( 1 )
elsif ( A == "length" )
	print( "length [N->length]\n" )
elsif ( A == "head" ) {
	I: int = N->head
}
elsif ( A == "tail" ) {
	I: int = N->tail
}
elsif ( A == "top" ) {
	I: int = N->top
}
elsif ( A == "field" ) {
	new H: holder()
	H->L->push( 1 )
}
elsif ( A == "new" ) {
	N = new list<int>()
	N->push( 5 )
	N->push_head( 6 )
	N->push_tail( 7 )
	N->push( 8 )
	N->push_head( 9 )
	N->push_tail( 10 )
	print( "length [N->length], head [N->head], " )
	print( "tail [N->tail], top [N->top]\n" )
}

S: start = parse start[ "x" ]
print( "length [N->length], head [N->head], tail [N->tail]\n" )
print( "after\n" )
##### ARGS #####
push
##### EXP #####
before
##### EXIT #####
1
