# Using a nil map stops the program, with exit status 1: inserting, finding,
# removing or setting a key, asking whether it has one, its length, and a loop
# over its keys. The output before the stop is kept. In a reduction action,
# an insert, a remove or a set is the form that records reverse code. The run
# "new" gives the map a value first, and nothing stops.

lex
	token id /[a-z]+/
	ignore /[ \n]+/
end

struct holder
	M: map<str, int>
end

global M: map<str, int>
global A: str = argv->pop()

def start
	[id]
	{
		if ( A == "new" ) {
			M->insert( "c", 3 )
			M->remove( "a" )
			M->set( "d", 4 )
			M->remove( "b" )
		}
		elsif ( A == "action_insert" )
			M->insert( "a", 1 )
		elsif ( A == "action_remove" )
			M->remove( "a" )
		elsif ( A == "action_set" )
			M->set( "a", 1 )
	}

print( "before\n" )

if ( A == "insert" )
	M->insert( "a", 1 )
elsif ( A == "find" )
	print( "find [M->find( "a" )]\n" )
elsif ( A == "remove" )
	M->remove( "a" )
elsif ( A == "set" )
	M->set( "a", 1 )
elsif ( A == "contains" )
	print( "contains [M->contains( "a" )]\n" )
elsif ( A == "length" )
	print( "length [M->length]\n" )
elsif ( A == "map_keys" ) {
	for K: str in map_keys( M )
		print( "key [K]\n" )
}
elsif ( A == "field" ) {
	new H: holder()
	H->M->insert( "a", 1 )
}
elsif ( A == "new" ) {
	M = new map<str, int>()
	M->insert( "a", 1 )
	M->set( "b", 2 )
	print( "find [M->find( "a" )], find b [M->find( "b" )], length [M->length], keys" )
	for K: str in map_keys( M )
		print( " [K]" )
	print( "\n" )
}

S: start = parse start[ "x" ]
print( "length [M->length], keys" )
for K: str in map_keys( M )
	print( " [K]" )
print( "\n" )
print( "after\n" )
