# Assigning nil to a struct or a list global in a production action that the
# parser keeps. The reverse code held the old struct as a tree, and the
# commit released it as one, aborting. The parse's first item makes the
# struct, after the parser, so the struct is still allocated when the
# reverse code is released. A parse whose only item that runs code is its
# first isn't restartable, so its actions can change globals.

struct point
	X: int
end

global G: point
global L: list<int>

lex
	token id /[a-z]+/
	literal `;
	ignore /[ \n]+/
end

def item
	[id `;]
	{
		G = nil
		L = nil
	}

def start
	[item item] commit

void make()
{
	G = new point()
	L = new list<int>()
	G->X = 7
}

parse S: start[ make() "abc ; def ;" ]
if ( !G )
	print( "G: nil\n" )
if ( !L )
	print( "L: nil\n" )
print( "after: ", S, "\n" )
##### EXP #####
G: nil
L: nil
after: abc ; def ;
