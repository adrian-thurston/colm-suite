# Assigning nil to a struct or a list global in a production action that the
# parser keeps. The reverse code held the old struct as a tree, and the
# commit released it as one, aborting. The parser is made before the struct,
# so the struct is still allocated when the reverse code is released.

struct point
	X: int
end

global G: point
global L: list<int>

lex
	token id /[a-z]+/
	literal `;
	ignore /[ \n]+/
end

def item
	[id `;]
	{
		G = nil
		L = nil
	}

def start
	[item item] commit

P: parser<start> = new parser<start>()
G = new point()
L = new list<int>()
G->X = 7
send P [ "abc ; def ;" ]
S: start = P->finish()
if ( !G )
	print( "G: nil\n" )
if ( !L )
	print( "L: nil\n" )
print( "after: ", S, "\n" )
##### EXP #####
G: nil
L: nil
after: abc ; def ;
