struct undo

	lex
		ignore /( ' ' | '\t')+/
		literal `* `( `) `^ `;
		token NL /'\n'/
		token id /[a-zA-Z_]+/
	end

	struct foo
		Start: start
	end

	def item 
		[id]
	|	[`( item* `)]

	def start 
		Foo: weak<foo>
		[item* `; NL]

end

Undo: undo = new undo()

parse Input: undo::start(Undo)[ stdin ]

Held: undo::foo = new undo::foo()
Input.Foo = Held
Input.Foo->Start = Input
print[ @Input.Foo->Start ]
###### IN ######
a b c ( d e ) f;
###### EXP ######
a b c ( d e ) f;
