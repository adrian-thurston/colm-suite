# A tree that holds, in a weak attribute, a struct that holds the tree. The
# tree is a parse's, given Undo, and its type can hold a struct, so it is a
# loan on Undo: a store through it is a store into what Undo holds, which
# takes only a new object, nil or what Undo holds. Held, made before, isn't.
struct undo

	lex
		ignore /( ' ' | '\t')+/
		literal `* `( `) `^ `;
		token NL /'\n'/
		token id /[a-zA-Z_]+/
	end

	struct foo
		Start: start
	end

	def item 
		[id]
	|	[`( item* `)]

	def start 
		Foo: weak<foo>
		[item* `; NL]

end

Undo: undo = new undo()

parse Input: undo::start(Undo)[ stdin ]

Held: undo::foo = new undo::foo()
Input.Foo = Held
Input.Foo->Start = Input
print[ @Input.Foo->Start ]
##### COMP_ERR #####
33:13: only a new object, nil or what Undo holds can go into Undo
