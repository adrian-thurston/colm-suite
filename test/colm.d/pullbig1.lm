# A pull of more than 2147483647 characters, more than the input functions
# can take, stops the program: an input pull in a token action, and a stream
# pull. Integer literals wrap at 32 bits (#464), so the lengths are built by
# multiplying. A pull of 2147483647 characters allocates 2G up front, which
# fails under the host's 1G address space limit, and that stops the program
# too. The host sends standard error to standard output, so each message is
# in the output, after what the program printed before it. The stop ends the
# host too: it never gets back from colm_run_program.

global Big: int = 65536 * 32768

lex
	ignore /[ \n]+/
	token id /[a-z]+/
	token semi /';'/
	{
		M: str = input->pull( Big )
		print( 'pulled ', M.length, '\n' )
		input->push( make_token( typeid<semi>, ';' ) )
	}
end

def start
	[id semi]

A: str = argv->pop()
print( 'before\n' )

if ( A == 'stream' ) {
	S: str = stdin->pull( Big )
	print( '[', S, ']\n' )
}
elsif ( A == 'stream4g' ) {
	Big = 65536 * 65536 + 3
	S: str = stdin->pull( Big )
	print( '[', S, ']\n' )
}
elsif ( A == 'input' ) {
	parse S: start[ 'a;' ]
	print( S, '\n' )
}
elsif ( A == 'memory' ) {
	S: str = stdin->pull( Big - 1 )
	print( '[', S, ']\n' )
}

print( 'after\n' )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>
#include <sys/resource.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	/* Limit the address space to 1G, so that a pull's allocation of 2G
	 * fails. */
	struct rlimit rl;
	rl.rlim_cur = rl.rlim_max = 1L << 30;
	setrlimit( RLIMIT_AS, &rl );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
stream
##### IN #####
abcdef--noeol
##### EXP #####
before
fatal: pull of a length too large
##### EXIT #####
1
##### ARGS #####
stream4g
##### IN #####
abcdef--noeol
##### EXP #####
before
fatal: pull of a length too large
##### EXIT #####
1
##### ARGS #####
input
##### IN #####
##### EXP #####
before
fatal: pull of a length too large
##### EXIT #####
1
##### ARGS #####
memory
##### IN #####
abcdef--noeol
##### EXP #####
before
fatal: out of memory
##### EXIT #####
1
