# A $N, @N or $*N in a reduction action names the Nth element of the
# action's production, so N past the last element is an error. One past the
# end, colm used to write a name that the commit code never declares, so the
# error came from the C++ compiler.

lex
	literal `;
	token number /[0-9]+/
	ignore /space+/
end

def line
	[number `;] :Line

def lines
	[line*]

reduction Sum
	line :Line
	{
		printf( "%ld %ld\n", @1->line, @3->line );
	}
end

reduce Sum lines[ stdin ]
##### COMP_ERR #####
21:34: @3 in the reduction action for line :Line is past the end of the production, which has 2 elements
