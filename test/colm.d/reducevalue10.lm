# A reduction action for an int. colm read its null lang el and segfaulted,
# with or without -m.
lex
	literal `;
	token number /[0-9]+/
	ignore /space+/
end

def line
	[number `;]

def lines
	[line*]

reduction Count
	int :x { }
end

reduce Count lines[ stdin ]
##### COMP_ERR #####
16:9: only a tree type can have a reduction action
