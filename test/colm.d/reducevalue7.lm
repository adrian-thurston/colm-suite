# The members of a reduction's value are plain C++, in no production, so a
# $, @ or $* reference in them is an error. With -m, colm used to write a name
# that nothing declares, which the C++ compiler then rejected.

lex
	literal `;
	token number /[0-9]+/
	ignore /space+/
end

def line
	[number `;]

def lines
	[line*]

reduction Count
	line { struct { long v; } s = { $$->v }; }
end

reduce Count lines[ stdin ]
##### COMP_ERR #####
18:34: $$ in the value of line: only a reduction action can refer to a production
