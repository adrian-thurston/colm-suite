# A reduction value for an int. With -m, colm read its null lang el and
# segfaulted.
lex
	literal `;
	token number /[0-9]+/
	ignore /space+/
end

def line
	[number `;]

def lines
	[line*]

reduction Count
	int { long q; }
end

reduce Count lines[ stdin ]
##### COMP_ERR #####
16:6: only a tree type can have a reduction value
