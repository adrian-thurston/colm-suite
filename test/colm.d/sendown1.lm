# A send to a parser while one of its actions runs stops the program: from a
# production's action, with each kind of send (text, a tree, a stream,
# nothing, and finish()), from a function a production's action calls, and
# from the action of a second parser that a production's action sends to.
# Each action reaches the parser through an attribute of a tree the program
# sends: two parsers can't share a context object, which a parser holds, and
# a restartable parser's actions can't send to a parser that a global holds.
# The host sends standard error to standard output, so the message is in the
# output, after what the program printed before it. The stop ends the host
# too: it never gets back from colm_run_program.
lex
	token word /[a-z]+/
	literal `@
	ignore /space+/
end

def hold
	P: parser<start>
	Q: parser<qstart>
	[`@]

global A: str = argv->pop()

void more( P: parser<start> )
{
	send P [" xy "]
}

def item
	[hold word]
	{
		if ( A == "text" )
			send r1.P [" xy "]
		elsif ( A == "tree" )
			send_tree r1.P [$r2]
		elsif ( A == "stream" )
			send r1.P [open( "/dev/null", "r" )]
		elsif ( A == "nothing" )
			send r1.P []
		elsif ( A == "finish" )
			T: start = r1.P->finish()
		elsif ( A == "function" )
			more( r1.P )
		elsif ( A == "other" ) {
			send_tree r1.Q [r1]
			send r1.Q [" " $r2 " "]
		}
	}

def start
	[item*]

def qitem
	[hold word]
	{
		send r1.P [" xy "]
	}

def qstart
	[qitem*]

parse H: hold[ "@" ]
P: parser<start> = new parser<start>()
Q: parser<qstart> = new parser<qstart>()
H.P = P
H.Q = Q

print( "before\n" )
send_tree P [H]
send P [" ab "]
send_tree P [H]
send P [" cd"]
S: start = P->finish()
print( "parsed: ", S, "\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
text
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
##### ARGS #####
tree
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
##### ARGS #####
stream
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
##### ARGS #####
nothing
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
##### ARGS #####
finish
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
##### ARGS #####
function
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
##### ARGS #####
other
##### EXP #####
before
fatal: send to a parser while one of its actions runs
##### EXIT #####
1
