# Backtracking over a send to a parser while one of its actions runs stops
# the program. Q's action sends to P while P is waiting for input. Later, P's
# action sends to Q, which fails the first alternative of qstart, so Q
# backtracks over its action, and would undo its send to P in the middle of
# P's action. Each parser reaches the other through an attribute of a tree
# the program sends to it: two parsers can't share a context object, which a
# parser holds, and a restartable parser's actions can't send to a parser
# that a global holds. The host sends standard error to standard output, so
# the message is in the output, after what the program printed before it.
# The stop ends the host too: it never gets back from colm_run_program.
lex
	literal `a `c `x `y `p `@ `%
end

def hp
	P: parser<pstart>
	[`@]

def hq
	Q: parser<qstart>
	[`%]

def qitem
	[`a hp]
	{
		print( "qitem\n" )
		send r2.P ["p"]
	}

def qstart
	[qitem `c `x]
|	[`a hp `c `y]

def pitem
	[hq]
	{
		print( "pitem\n" )
		send r1.Q ["y"]
	}

def pstart
	[`p pitem*]

parse HP: hp[ "@" ]
parse HQ: hq[ "%" ]
P: parser<pstart> = new parser<pstart>()
Q: parser<qstart> = new parser<qstart>()
HP.P = P
HQ.Q = Q

print( "before\n" )
send Q ["a"]
send_tree Q [HP]
send Q ["c"]
send_tree P [HQ]
send P [] eos
print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### EXP #####
before
qitem
pitem
fatal: backtracking over a send to a parser while one of its actions runs
##### EXIT #####
1
