# Backing up over a send to a parser while that parser is itself backing up,
# and not in one of its actions, goes on as before. R's action sends to P,
# whose action sends to Q. Later, Q's action sends to P. Then R backs up over
# its action: P undoes its parse, and while P runs the reverse code of its
# action, Q backs up over its own action, which undoes Q's send to P. That
# send came after P's action, so the undo finds nothing of P's to back up.
lex
	literal `a `c `x `y `p `q `m
end

def ritem
	[`a]
	{
		print( "ritem\n" )
		send P ["pp"]
	}

def rstart
	[ritem `c `x]
|	[`a `c `y]

global Once: bool = false

def pitem
	[`p]
	{
		print( "pitem\n" )
		if ( !Once ) {
			Once = true
			send Q ["q"]
		}
	}

def mitem
	[`m]

def pstart
	[pitem* mitem*]

def qitem
	[`q]
	{
		print( "qitem\n" )
		send P ["m"]
	}

def qstart
	[qitem*]

global R: parser<rstart> = new parser<rstart>()
global P: parser<pstart> = new parser<pstart>()
global Q: parser<qstart> = new parser<qstart>()

print( "before\n" )
send R ["ac"]
print( "sending q\n" )
send Q ["q"]
print( "sending y\n" )
send R ["y"]
print( "after\n" )
RS: rstart = R->finish()
print( "R: ", RS, "\n" )
PS: pstart = P->finish()
print( "P: <", PS, ">\n" )
QS: qstart = Q->finish()
print( "Q: ", QS, "\n" )
##### EXP #####
before
ritem
pitem
sending q
qitem
pitem
sending y
after
R: acy
P: <>
qitem
Q: q
