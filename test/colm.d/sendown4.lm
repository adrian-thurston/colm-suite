# Backing up over a send to a parser while that parser is itself backing up,
# and not in one of its actions, goes on as before. R's action sends to P,
# whose action sends to Q. Later, Q's action sends to P. Then R backs up over
# its action: P undoes its parse, and while P runs the reverse code of its
# action, Q backs up over its own action, which undoes Q's send to P. That
# send came after P's action, so the undo finds nothing of P's to back up.
# Each parser reaches the next through an attribute of a tree sent to it:
# two parsers can't share a context object, which a parser holds, and a
# restartable parser's actions can't send to a parser that a global holds.
lex
	literal `a `c `x `y `p `q `m `@ `%
end

def hp
	P: parser<pstart>
	[`@]

def hq
	Q: parser<qstart>
	[`%]

def ritem
	[`a hp hq]
	{
		print( "ritem\n" )
		send r2.P ["p"]
		send_tree r2.P [r3]
		send_tree r2.P [r2]
		send r2.P ["p"]
	}

def rstart
	[ritem `c `x]
|	[`a hp hq `c `y]

# The first p, which P takes from R's action with the trees that reach Q and
# P, sends to Q.
def pfirst
	[`p hq hp]
	{
		print( "pitem\n" )
		send r2.Q ["q"]
		send_tree r2.Q [r3]
	}

def pitem
	[`p]
	{
		print( "pitem\n" )
	}

def mitem
	[`m]

def pstart
	[pfirst pitem* mitem*]
|	[]

def qitem
	[`q hp]
	{
		print( "qitem\n" )
		send r2.P ["m"]
	}

def qstart
	[qitem*]

parse HP: hp[ "@" ]
parse HQ: hq[ "%" ]
R: parser<rstart> = new parser<rstart>()
P: parser<pstart> = new parser<pstart>()
Q: parser<qstart> = new parser<qstart>()
HP.P = P
HQ.Q = Q

print( "before\n" )
send R ["a"]
send_tree R [HP]
send_tree R [HQ]
send R ["c"]
print( "sending q\n" )
send Q ["q"]
send_tree Q [HP]
print( "sending y\n" )
send R ["y"]
print( "after\n" )
RS: rstart = R->finish()
print( "R: ", RS, "\n" )
PS: pstart = P->finish()
print( "P: <", PS, ">\n" )
QS: qstart = Q->finish()
print( "Q: ", QS, "\n" )
##### EXP #####
before
ritem
pitem
sending q
qitem
pitem
sending y
after
R: a@%cy
P: <>
qitem
Q: q@
