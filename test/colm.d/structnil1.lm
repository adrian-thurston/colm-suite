# Reading or setting a field of a nil struct stops the program with exit
# status 1, after the output printed before it. That covers a list or map
# held in the field. A struct made with new works. The argument picks the use.

lex
	token id /[a-z]+/
	ignore /[ \n]+/
end

def item
	A: str
	[id]

struct pair
	F: str
end

struct S
	F: str
	I: int
	L: list<str>
	M: map<str, str>
	T: item
	P: pair
end

int show( V: S )
{
	print( V->F, '\n' )
}

A: str = argv->pop()
V: S
G: S = new S()
G->L = new list<str>()

print( "before\n" )

if ( A == "new" ) {
	G->F = 'a'
	G->I = 1
	G->L->push( 'b' )
	G->P = new pair()
	G->P->F = 'c'
	print( G->F, ' ', G->I, ' ', G->L->length, ' ', G->P->F, '\n' )
}
elsif ( A == "read" )
	print( V->F, '\n' )
elsif ( A == "read_int" )
	print( V->I, '\n' )
elsif ( A == "length" )
	print( V->L->length, '\n' )
elsif ( A == "push" )
	V->L->push( 'a' )
elsif ( A == "find" )
	print( V->M->find( 'a' ), '\n' )
elsif ( A == "for" ) {
	for X: str in V->L
		print( X, '\n' )
}
elsif ( A == "read_attr" )
	print( V->T.A, '\n' )
elsif ( A == "set_attr" )
	V->T.A = 'a'
elsif ( A == "set" )
	V->F = 'a'
elsif ( A == "set_int" )
	V->I = 1
elsif ( A == "set_list" )
	V->L = new list<str>()
elsif ( A == "nested_read" )
	print( G->P->F, '\n' )
elsif ( A == "nested_set" )
	G->P->F = 'a'
elsif ( A == "param" )
	show( V )

print( "after\n" )
##### ARGS #####
new
##### EXP #####
before
a 1 1 c
after
##### EXIT #####
0
##### ARGS #####
read
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
read_int
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
length
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
push
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
find
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
for
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
read_attr
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
set_attr
##### EXP #####
before
##### EXIT #####
1
