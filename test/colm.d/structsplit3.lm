#
# Setting a child of a global's tree, or the data of a global token, that a
# local shares copies the tree first, and the local keeps the old one. The
# argument picks the program. On main both changed the local's tree too
# (#628).
#

lex
	token id /[a-z]+/
	token num /[0-9]+/
	ignore /[ \n]+/
end

def pair
	[L: id R: num]

def wrap
	[P: pair]

global A: str = argv->pop()
global W: wrap = parse wrap[ "w 1" ]
global G: id = make_token( typeid<id>, "abc" )

if A == 'child' {
	QW: wrap = W
	W.P = parse pair[ "z 9" ]
	print( "W [W] QW [QW]\n" )
}
else {
	Q: id = G
	G.data = 'z'
	print( "G [G] Q [Q]\n" )
}
##### ARGS #####
child
##### EXP #####
W z 9 QW w 1
##### ARGS #####
token
##### EXP #####
G z Q abc
