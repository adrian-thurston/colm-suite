# Assigning to this in a token action is a compile error. this is the
# parse's context, and nothing can set it. A write through it, this->N, is
# allowed (ctxthis1).
context c
	N: int
	lex
		token word /[a-z]+/
		{
			this = nil
			input->push( make_token( typeid<word>, input->pull( match_length ) ) )
		}
		ignore /space+/
	end
	def start [word*]
end
C: c = new c()
parse S: c::start( C )[ "a b" ]
print( S, "\n" )
##### COMP_ERR #####
9:4: cannot assign to "this"
