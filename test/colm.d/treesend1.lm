# #729's program: a tree whose attribute holds a list, sent to a parser with
# send_tree, goes into the parse as itself, and shares the list with the
# program.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

# A1 is tried first: the action runs, then the parser backs up to A2.
def item
	[holder]
	{
		r1.L->push_tail( "x" )
	}

def start
	[A1 item* `; `^ NL]
|	[A2 holder `; NL]

parse H: holder[ "h" ]
H.L = new list<str>()
P: parser<start> = new parser<start>()
send_tree P [H]
send P " ;"
print( "length ", H.L->length, "\n" )
H.L->pop_tail()
send P "\n"
P->finish()
print( "done\n" )
