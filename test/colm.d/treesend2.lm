# #729's program through a global: the tree that send_tree sends is a
# global's.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

# A1 is tried first: the action runs, then the parser backs up to A2.
def item
	[holder]
	{
		r1.L->push_tail( "x" )
	}

def start
	[A1 item* `; `^ NL]
|	[A2 holder `; NL]

global G: holder
parse H: holder[ "h" ]
H.L = new list<str>()
G = H
P: parser<start> = new parser<start>()
send_tree P [G]
send P " ;"
print( "length ", G.L->length, "\n" )
G.L->pop_tail()
send P "\n"
P->finish()
print( "done\n" )
##### COMP_ERR #####
36:14: cannot send_tree a holder, which can hold a list, map, parser, stream or struct: send its text
