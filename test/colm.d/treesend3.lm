# #729's program in one statement: the tree is an item of a parse_tree, and
# an item after it pops the list.
lex
	literal `h
end

def holder
	L: list<str>
	[`h]

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

# A1 is tried first: the action runs, then the parser backs up to A2.
def item
	[holder]
	{
		r1.L->push_tail( "" )
	}

def start
	[A1 item* `; `^ NL]
|	[A2 holder `; NL]

parse H: holder[ "h" ]
H.L = new list<str>()
parse_tree S: start[ H " ;" H.L->pop_tail() "\n" ]
print( "done\n" )
