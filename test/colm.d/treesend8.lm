# Two parsers that reach each other through parser attributes of trees sent
# with send_tree. #619's cases, sendown1-4, took this route to its stop on
# backing up over a send to a parser while one of its actions runs, and were
# removed with this rule. A tree whose attributes can hold a parser is
# refused like one that can hold a list: the program and the parsers'
# actions could all send to the parsers it carries, and backing up over an
# action's send would take out the wrong text.
lex
	literal `a `c `x `y `p `@ `%
end

def hp
	P: parser<pstart>
	[`@]

def hq
	Q: parser<qstart>
	[`%]

def qitem
	[`a hp]
	{
		print( "qitem\n" )
		send r2.P ["p"]
	}

def qstart
	[qitem `c `x]
|	[`a hp `c `y]

def pitem
	[hq]
	{
		print( "pitem\n" )
		send r1.Q ["y"]
	}

def pstart
	[`p pitem*]

parse HP: hp[ "@" ]
parse HQ: hq[ "%" ]
P: parser<pstart> = new parser<pstart>()
Q: parser<qstart> = new parser<qstart>()
HP.P = P
HQ.Q = Q

print( "before\n" )
send Q ["a"]
send_tree Q [HP]
send Q ["c"]
send_tree P [HQ]
send P [] eos
print( "after\n" )
##### COMP_ERR #####
50:14: cannot send_tree a hp, which can hold a list, map, parser, stream or struct: send its text
