# Leaving a loop over a user iterator early, while the iterator is in a
# function that it called inside an expression and that yielded. The words of
# the expression lie under the function's frame. The teardown pops them, and
# ends what is under them as at any other call. In iter, that is the
# iterator's own frame. In loop, it is also the iterator's loop over j, whose
# iterator's locals are released. With func, the expression is in a function
# f between the iterator and the one that yielded, and f's frame is ended
# before the iterator's. Before, the teardown stopped at the call, and loop
# lost j's locals, which the LOST section listed.
iter j()
{
	J: str = "j"
	yield J
}

int g()
{
	L: str = "l"
	yield L
	return 1
}

iter i()
{
	S: str = "s"
	X: int = 1 + g()
}

iter k()
{
	for U: str in j() {
		X: int = 1 + g()
	}
}

int f()
{
	X: int = 1 + g()
	return X
}

iter m()
{
	S1: str = "s1"
	S2: str = "s2"
	S3: str = "s3"
	f()
}

Where: str = argv->pop()
if Where == "iter" {
	for T: str in i() {
		print( T, "\n" )
		break
	}
}
if Where == "loop" {
	for T: str in k() {
		print( T, "\n" )
		break
	}
}
if Where == "func" {
	for T: str in m() {
		print( T, "\n" )
		break
	}
}
print( "done\n" )
##### ARGS #####
iter
##### EXP #####
l
done
##### EXIT #####
0
##### LOST #####
##### ARGS #####
loop
##### EXP #####
l
done
##### EXIT #####
0
##### LOST #####
##### ARGS #####
func
##### EXP #####
l
done
##### EXIT #####
0
##### LOST #####
