#
# Undoing an action puts back the value the action found. A write from
# outside the parse, made between two sends, would be lost when the parser
# backed up over an action that ran before it, so it doesn't compile: the
# program changes a context object only while it sets it up. The first send
# reduces a; the second would reach the ";" and back up from A1 to A2, over
# a's action.
#

context ctx
	lex
		literal `^ `;
		token id /[a-z]+/
		ignore /space+/
	end

	I: int

	def item
		[id]
		{
			I = I + 1
			print( "item ", $r1, ", I ", I, "\n" )
		}

	def A1 []
	def A2 []

	def start
		[A1 item* `^]
	|	[A2 item* `;]
end

C: ctx = new ctx()
P: parser<ctx::start> = new parser<ctx::start>( C )
send P "a b "
print( "main sets I to 100\n" )
C->I = 100
send P "c ;" eos
print( "I ", C->I, ", tree ", P->tree, "\n" )
##### COMP_ERR #####
38:1: cannot change C, a context object, outside its setup
