# A list's push_el, push_head_el and push_tail_el in a reduction action stop
# on an element a list holds, as they do at the top level. Input "* * ;" is
# parsed as A1 first, which runs the actions, and then backs up to A2. In the
# runs that stop, the program ends in the first action. In the run "free", the
# actions move elements no list holds, backing up puts them back, and they can
# move again after.

global L: list<str> = new list<str>()
global K: list<str> = new list<str>()
global E: list_el<str>
global A: str = argv->pop()
global Pushes: int = 0

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

def item
	[`*]
	{
		# Only the first action pushes E, so that without the check, the
		# second can't push it again and make a cycle in K.
		if ( Pushes == 0 ) {
			Pushes = 1
			if ( A == "held_tail" )
				K->push_tail_el( E )
			elsif ( A == "held_head" )
				K->push_head_el( E )
			elsif ( A == "held_push_el" )
				K->push_el( E )
		}
		if ( A == "free" ) {
			F: list_el<str> = L->pop_head_el()
			K->push_tail_el( F )
			G: list_el<str> = L->pop_tail_el()
			K->push_head_el( G )
		}
		print "action: L [L->length], K [K->length]\n"
	}

def start
	[A1 item* `; `^ NL]
|	[A2 `* `* `; NL]

L->push_tail( "a" )
L->push_tail( "b" )
L->push_tail( "c" )
L->push_tail( "d" )
L->push_tail( "e" )
E = L->head_el->next
print "before\n"

parse S: start[ stdin ]
print( S )
print "L [L->length]:"
for V: str in L
	print " [V]"
print "\nL rev:"
for V: str in rev_list_iter( L )
	print " [V]"
print "\nK [K->length]\n"

while ( L->length > 0 ) {
	F: list_el<str> = L->pop_tail_el()
	K->push_head_el( F )
}
print "moved: L [L->length], K [K->length]:"
for V: str in K
	print " [V]"
print "\nK rev:"
for V: str in rev_list_iter( K )
	print " [V]"
print "\n"
##### ARGS #####
held_tail
##### IN #####
* * ;
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
held_head
##### IN #####
* * ;
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
held_push_el
##### IN #####
* * ;
##### EXP #####
before
##### EXIT #####
1
##### ARGS #####
free
##### IN #####
* * ;
##### EXP #####
before
action: L 3, K 2
action: L 1, K 4
* * ;
L 5: a b c d e
L rev: e d c b a
K 0
moved: L 0, K 5: a b c d e
K rev: e d c b a
