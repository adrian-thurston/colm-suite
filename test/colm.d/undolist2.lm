# A list's pops and pushes in a reduction action are undone when the parser
# backs up. Input "* * ;" is parsed as A1 first, which runs the actions, and
# then backs up to A2. The actions move values from L to K, backing up puts
# them back, and they can move again after.

global L: list<str> = new list<str>()
global K: list<str> = new list<str>()

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

def item
	[`*]
	{
		K->push_tail( L->pop_head() )
		K->push_head( L->pop_tail() )
		print "action: L [L->length], K [K->length]\n"
	}

def start
	[A1 item* `; `^ NL]
|	[A2 `* `* `; NL]

L->push_tail( "a" )
L->push_tail( "b" )
L->push_tail( "c" )
L->push_tail( "d" )
L->push_tail( "e" )
print "before\n"

parse S: start[ stdin ]
print( S )
print "L [L->length]:"
for V: str in L
	print " [V]"
print "\nL rev:"
for V: str in rev_list_iter( L )
	print " [V]"
print "\nK [K->length]\n"

while ( L->length > 0 )
	K->push_head( L->pop_tail() )
print "moved: L [L->length], K [K->length]:"
for V: str in K
	print " [V]"
print "\nK rev:"
for V: str in rev_list_iter( K )
	print " [V]"
print "\n"
##### IN #####
* * ;
##### EXP #####
before
action: L 3, K 2
action: L 1, K 4
* * ;
L 5: a b c d e
L rev: e d c b a
K 0
moved: L 0, K 5: a b c d e
K rev: e d c b a
