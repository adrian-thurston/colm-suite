#
# A map's remove and set in reduction actions, and backtracking over them.
# The undo of each must put back what it took out or replaced. Input ending
# in "; ^" is parsed as A1, keeping what the actions did. Input ending in ";"
# is parsed as A1 first, reducing every item, then backs up to A2, whose
# items have no actions, so the map must come out as it went in.
#

global M: map<str, str> = new map<str, str>()

lex
	ignore /[ \t]+/
	literal `- `* `= `^ `;
	token NL /'\n'/
	token id /[a-z]+/
end

def A1 []
def A2 []

def item
	# Remove by key. A key not in the map removes nothing.
	[`- id]
	{
		V: str = M->remove( $r2 )
		if ( V )
			print "removed [$r2] [V]\n"
		else
			print "no [$r2]\n"
	}

	# Set: replaces the value of a key in the map, adds one that isn't.
|	[`* id]
	{
		print "set [$r2] [M->set( $r2, "set" )]\n"
	}

	# Replace. Undoing it takes the new element out before putting the old
	# one back.
|	[`= id]
	{
		M->remove( $r2 )
		M->insert( $r2, "new" )
	}

def plain_item
	[`- id]
|	[`* id]
|	[`= id]

def start
	[A1 item* `; `^ NL]
|	[A2 plain_item* `; NL]

M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )
M->insert( "d", "4" )

parse S: start[ stdin ]
print( S )

for K: str in map_keys( M )
	print "[K] [M->find( K )]\n"

##### IN #####
-a *b -zz =c *e ; ^
##### EXP #####
removed a 1
set b 0
no zz
set e 1
-a *b -zz =c *e ; ^
b set
c new
d 4
e set
##### IN #####
-a *b -zz =c *e ;
##### EXP #####
removed a 1
set b 0
no zz
set e 1
-a *b -zz =c *e ;
a 1
b 2
c 3
d 4
