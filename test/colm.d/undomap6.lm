# Moving a value to a new key in a reduction action, with remove and insert,
# and backtracking undoes both. Input ending in "; ^" is parsed as A1,
# keeping the move. Input ending in ";" is parsed as A1 first, then backs up
# to A2, and the value is back under its old key.

global M: map<str, str> = new map<str, str>()

lex
	ignore /[ \t]+/
	literal `+ `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

def item
	[`+]
	{
		V: str = M->remove( "a" )
		M->insert( "z", V )
		print( "moved a to z, length [M->length]\n" )
	}

def plain_item
	[`+]

def start
	[A1 item* `; `^ NL]
|	[A2 plain_item* `; NL]

M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )
M->insert( "d", "4" )
M->insert( "e", "5" )

parse S: start[ stdin ]
print( S )
for K: str in map_keys( M )
	print( "[K] [M->find( K )]\n" )
if ( M->contains( "a" ) )
	print( "contains a\n" )
if ( M->contains( "z" ) )
	print( "contains z\n" )
##### IN #####
+ ; ^
##### EXP #####
moved a to z, length 5
+ ; ^
b 2
c 3
d 4
e 5
z 1
contains z
##### IN #####
+ ;
##### EXP #####
moved a to z, length 5
+ ;
a 1
b 2
c 3
d 4
e 5
contains a
