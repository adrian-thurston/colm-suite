# Backing up over a map's insert, insert_el, detach_el or remove in a
# reduction action, or over a write to an element's key, stops the program
# when code outside the parse has moved the element into or out of a map
# since. The undo would otherwise corrupt the maps. Each run sends "* ;",
# which the parser takes as A1, running the action of item. move() then moves
# the element, and the "\n" sent next makes the parser back up to A2. The
# parse_item run does the same in one parse statement. The host sends
# standard error to standard output, so the message is in the output.

global Mode: str = argv->pop()
global M: map<str, str> = new map<str, str>()
global O: map<str, str> = new map<str, str>()
global I: map<int, str> = new map<int, str>()
global H: map_el<str, str>
global R: map_el<str, str>
global G: map_el<str, str>
global J: map_el<int, str>

lex
	ignore /[ \t]+/
	literal `* `^ `;
	token NL /'\n'/
end

def A1 []
def A2 []

def item
	[`*]
	{
		if ( Mode == "detach_el" || Mode == "detach_el_same" ||
				Mode == "parse_item" )
			M->detach_el( H )
		elsif ( Mode == "remove" )
			R = M->remove( "b" )
		elsif ( Mode == "insert_el" || Mode == "insert_el_moved" )
			M->insert_el( G )
		elsif ( Mode == "insert" )
			M->insert( "d", "4" )
		elsif ( Mode == "key" )
			G->key = "z"
		elsif ( Mode == "key_int" )
			J->key = 9
		print( "action\n" )
	}

def start
	[A1 item* `; `^ NL]
|	[A2 `* `; NL]

str move()
{
	if ( Mode == "detach_el" || Mode == "parse_item" )
		O->insert_el( H )
	elsif ( Mode == "detach_el_same" )
		M->insert_el( H )
	elsif ( Mode == "remove" )
		O->insert_el( R )
	elsif ( Mode == "insert_el" || Mode == "insert" )
		M->detach_el( M->find_el( "d" ) )
	elsif ( Mode == "insert_el_moved" ) {
		M->detach_el( G )
		O->insert_el( G )
	}
	elsif ( Mode == "key" )
		M->insert_el( G )
	elsif ( Mode == "key_int" )
		I->insert_el( J )
	print( "moved\n" )
	return ""
}

M->insert( "a", "1" )
M->insert( "b", "2" )
M->insert( "c", "3" )
O->insert( "z", "26" )
H = M->find_el( "b" )
G = new map_el<str, str>()
G->key = "d"
G->value = "4"
I->insert( 1, "1" )
J = new map_el<int, str>()
J->key = 2
J->value = "2"

if ( Mode == "parse_item" ) {
	parse S: start[ "* ;" move() "\n" ]
}
else {
	new P: parser<start>()
	send P "* ;"
	move()
	send P "\n"
	T: start = P->finish()
}
print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
detach_el
##### EXP #####
action
moved
fatal: backing up over detach_el of an element now in a map
##### EXIT #####
1
