#
# An input's auto_trim(), called through input in a token action, before the
# action's pull and push. It may not leave a unit of reverse code open, which
# crashes the parser at the end of the action. The parse backs up over @b,
# undoing its action's pull and push but not auto_trim(), and scans @b again.
#

lex
	ignore /[ \n]+/
	token id /[a-z]+/
	literal `; `( `)

	# Give the name after the @ back as text, to be scanned again as an id.
	token at /'@' [a-z]+/
	{
		input->auto_trim( true )
		input->pull( 1 )
		input->push( input->pull( match_length - 1 ) )
	}
end

# Parens must balance here. When they don't, the parser backtracks over
# everything and takes flat instead.
def item
	[id]
|	[`( item* `)]

def flat
	[id] | [`(] | [`)]

def start
	[item* `;]
|	[flat* `;]

parse S: start[ " @a ( @b ;\n" ]
print( "S: {", S, "}\n" )

# The first send scans @a, whose action turns auto_trim on, so the second
# send loses the spaces around S.
P: parser<start> = new parser<start>()
send P "@a "
send P [S] eos
print( "P: {", P->tree, "}\n" )
##### EXP #####
S: { a ( b ;
}
P: {a a ( b ;}
